# ================================================
# .dockerignore — ملفات لا ترفع داخل Docker Image
# ================================================

# بيانات سرية
.env
smtp.conf

# قاعدة البيانات المحلية
*.db
*.sqlite
*.sqlite3

# Python cache
__pycache__/
*.pyc
*.pyo
.Python

# Virtual environments
venv/
env/
.venv/

# IDE
.idea/
.vscode/

# Git
.git/
.github/

# Backups
*.backup
*.bak

# Tests
tests/
pytest.ini
.pytest_cache/
test_*.py
verify_syntax.py

# One-off maintenance and patch utilities (not part of the runtime image)
fix_*.py
patch_*.py
check_db.py
seed_real_offices.py
update_company_credentials.py
export_all_databases.py

# Documentation
*.md
docs/

# OS
.DS_Store
Thumbs.db

# Uploads (يُضاف كـ volume في وقت التشغيل)
static/uploads/
private_uploads/
rag_engine/knowledge_data/
rag_engine/chroma_db/
logs/
temp_contract_*
temp_compare_*

# Video files
*.mp4
*.avi
*.mov
