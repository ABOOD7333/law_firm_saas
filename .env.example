# ================================================
# LawSaaS Platform - Environment Variables Template
# Copy this file as .env and fill in your values
# NEVER commit the actual .env file to version control
# ================================================

# --- Database ---
DATABASE_URL=sqlite:///./law_firm.db

# --- Session Encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))") ---
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_KEY

# --- Application Settings ---
APP_ENV=production
DEBUG=false

# --- SMTP Email Settings ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER=LawSaaS
SMTP_USE_TLS=true

# --- Private Ollama model (Railway private networking) ---
USE_LOCAL_LLM=true
OLLAMA_API_URL=http://ollama.railway.internal:11434/api/generate
OLLAMA_MODEL=qwen2.5:3b

# --- Upload Settings ---
UPLOAD_DIR=static/uploads/documents
MAX_UPLOAD_SIZE_MB=20
