# ============================================
# .gitignore — LawSaaS
# ============================================

# --- بيانات سرية (NEVER COMMIT) ---
.env
smtp.conf
*.conf

# --- قاعدة البيانات المحلية ---
*.db
*.sqlite
*.sqlite3

# --- Python cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python

# --- Virtual environments ---
venv/
env/
.venv/
.env/
ENV/

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo

# --- Backups ---
*.backup
*.bak

# --- Uploads (لا نرفع ملفات المستخدمين) ---
static/uploads/
private_uploads/

# --- Alembic ---
# نرفع migrations لكن لا نرفع قاعدة بيانات الـ alembic temp
alembic/versions/__pycache__/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Distribution ---
dist/
build/
*.egg-info/

# --- Local Runtime / Data ---
tessdata/
rag_engine/chroma_db/
rag_engine/knowledge_data/
temp_contract_*
temp_compare_*

# --- ملفات اختبار مؤقتة (تحتوي مفاتيح) ---
scratch/

# --- ملفات قاعدة البيانات المؤقتة ---
*.db-shm
*.db-wal

# --- ملفات PDF ومخططات مؤقتة ---
120.pdf
Detailed_Platform_Review_Report.pdf
150_Comprehensive_Architecture.pdf
154.pdf
154_Server_Database.pdf
generate_pdf_154.py
generate_perfect_pdf_154.py
generate_server_pdf.py
response_output.txt
